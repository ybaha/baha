# Copy to `.env` for local development. Never commit real values.

# Public site URL for metadata, sitemap.xml and robots.txt (optional; defaults to https://ybaha.com).
SITE_URL="https://ybaha.com"

# Standalone API origin for browser RPC and Better Auth (no path; dev default http://localhost:8787).
NEXT_PUBLIC_API_URL="http://localhost:8787"

# Optional: canonical host for client visit notifications (defaults to https://ybaha.com).
# NEXT_PUBLIC_SITE_URL="https://ybaha.com"

# Optional: enable notifications on other production-built staging hosts.
# Localhost and read-only previews are always excluded.
# NEXT_PUBLIC_ENABLE_VISIT_NOTIFICATIONS="true"

# Optional: disable auth/mutations on custom preview hosts (Cloudflare *.pages.dev is automatic).
# NEXT_PUBLIC_DISABLE_AUTH="true"

# Backend secrets and database settings live in server/.env.example (not used by the static web build).
