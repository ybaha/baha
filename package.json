{
  "name": "portfolio-2024",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "server"
  ],
  "scripts": {
    "dev": "npm run build:contracts && next dev",
    "build": "npm run build:web",
    "build:web": "npm run build:contracts && next build",
    "build:contracts": "npm run build -w @baha/contracts",
    "build:server": "npm run build:contracts && npm run build -w @baha/server",
    "typecheck": "npm run build:contracts && npm run typecheck:web && npm run typecheck:contracts && npm run typecheck:server",
    "typecheck:web": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "typecheck:contracts": "npm run typecheck -w @baha/contracts",
    "typecheck:server": "npm run typecheck -w @baha/server",
    "test": "npm run build:contracts && node --import tsx --test --test-timeout=30000 test/*.test.cjs test/unit/*.test.cjs test/unit/*.test.mjs",
    "test:integration": "npm run build:contracts && npm run generate:legacy-test && node --import tsx --test --test-timeout=60000 test/integration/**/*.test.mjs",
    "test:server": "npm run build:contracts && node --import tsx --test --test-timeout=60000 test/integration/server-*.test.mjs",
    "test:browser": "\"${BROWSER_PYTHON:-python3}\" test/browser/static-export.py",
    "generate:legacy-test": "prisma generate --config test/fixtures/legacy-prisma/prisma.config.ts",
    "start": "serve out -l ${PORT:-3000}",
    "preview": "serve out -l ${PORT:-3000}",
    "lint": "oxlint . && node scripts/check-boundaries.mjs && node scripts/check-browser-bundle.mjs"
  },
  "dependencies": {
    "@baha/contracts": "0.0.0",
    "@orpc/client": "1.15.7",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/container-queries": "^0.1.1",
    "better-auth": "1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "geist": "^1.3.0",
    "gray-matter": "^4.0.3",
    "next": "16.4.0",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hot-toast": "^2.4.1",
    "react-wrap-balancer": "^1.1.0",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-code-titles": "^1.2.0",
    "rehype-prism-plus": "^2.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tailwindcss/typography": "^0.5.10",
    "@types/node": "^22",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.14",
    "@types/react-dom": "^19.0.6",
    "@typescript/typescript6": "^6.0.2",
    "autoprefixer": "^10.4.18",
    "esbuild": "^0.25.0",
    "next-auth": "^4.24.15",
    "oxlint": "1.88.0",
    "pg": "8.23.1",
    "postcss": "8.5.29",
    "postcss-import": "^15.1.0",
    "prisma": "7.10.0",
    "serve": "^14.2.4",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.19.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
